generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PaidTo {
  FRANCISCA
  EDVALDO
}

model Payment {
  id        String   @id @default(cuid())
  name      String
  age       Int
  value     Decimal  @db.Decimal(12, 2)
  paidTo    PaidTo
  createdAt DateTime @default(now())

  @@index([paidTo])
  @@index([age])
}
